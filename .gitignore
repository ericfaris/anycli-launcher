# Test-generated artifacts (recreated on every test run; cleaned up on success,
# but left behind if a run is interrupted).
tests/.mock-bin/
tests/.test.log

# go build output
dist/

# Windows NTFS marks a file downloaded from the internet (e.g. via a browser
# zip download) with a same-named ":Zone.Identifier" alternate-data-stream
# companion. They carry no content, and their literal colon makes Git for
# Windows refuse to check the tree out at all ("invalid path").
*:Zone.Identifier
