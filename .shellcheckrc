# shellcheck configuration for anycli
#
# Each disabled check below is either an intentional pattern in this codebase or
# a documented false positive. Everything NOT listed here stays enabled, so real
# new issues (unquoted expansions SC2086, useless subshells, bad test operators,
# etc.) still fail the shellcheck gate in tests/run-tests.sh.
#
# Re-evaluate this list periodically — if a suppressed check no longer has any
# occurrences, remove it so the protection tightens over time.

# SC2016 — "Expressions don't expand in single quotes."
# INTENTIONAL. The launcher generates a tab-launch script by emitting literal
# shell code via `printf '%s\n' '...$var...'`. Those variables ($_saved, $_junk,
# $__git_ps1, PS1 escapes) must NOT expand at generation time; they belong to
# the generated script's runtime. Single quotes are required, not a mistake.
disable=SC2016

# SC2155 — "Declare and assign separately to avoid masking return values."
# Accepted style. The pattern `local x="$(_lk_indirect ...)"` is pervasive; the
# command substitutions here cannot meaningfully fail, so the masked exit status
# is irrelevant. Splitting every one adds noise without catching real bugs.
disable=SC2155

# SC2178 — "Variable was used as an array but is now assigned a string."
# FALSE POSITIVE. Integer counters named `found` are flagged because shellcheck's
# cross-scope name tracking confuses them with unrelated array usage elsewhere.
# These are plain counters (`found=$(( found + 1 ))`), never arrays.
disable=SC2178

# SC2034 — "Variable appears unused."
# Pre-existing. The theme-application helpers destructure a theme entry into
# named fields (bg, cursor, fg, green, ...) for readability even when only some
# are consumed. Tracked as a future cleanup, not a correctness issue.
disable=SC2034

# SC2206 — "Quote to prevent word splitting/globbing."
# Pre-existing, intentional. Version strings ("1.12.0") and space-separated
# field lists are split into arrays deliberately; the inputs are controlled
# (numeric version components, internal field records), not user data.
disable=SC2206

# SC1003 / SC2059 — encoding-helper escaping in _lk_safe_name / _lk_decode_name.
# Intentional low-level byte/escape handling; the flagged forms are correct for
# the hex-encoding scheme used for project-name sanitization.
disable=SC1003
disable=SC2059
